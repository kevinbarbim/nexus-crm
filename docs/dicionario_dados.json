      "CONSTRAINT CK_leads_fechamento CHECK ((etapa IN(N'GANHO',N'PERDIDO') AND encerrado_em IS NOT NULL) OR (etapa NOT IN(N'GANHO',N'PERDIDO') AND encerrado_em IS NULL))"
